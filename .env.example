# --- AI (optional) --------------------------------------------------------------
# Practice (reading, listening with generated audio, vocabulary, mistakes, plans, mock exams)
# works WITHOUT a key. Gemini is used only for: writing/speaking evaluation on request, the tutor,
# and explicit admin content/audio generation.
GEMINI_API_KEY=
# Text model (default gemini-2.5-flash, which has a free tier). Change when Google updates models.
GEMINI_MODEL=
# --- Listening audio (generated once, stored in DATA_DIR/audio-assets) -------------
# edge (default): Microsoft Edge neural voices (en-CA Clara/Liam + en-US Jenny/Guy), no API key.
#                 Unofficial service — availability/terms may change; generate early and back up the files.
# gemini:         Gemini TTS (needs GEMINI_API_KEY).
AUDIO_PROVIDER=edge
# Optional voice mapping per role, JSON, e.g. {"female_b":"en-US-AriaNeural"}
EDGE_TTS_VOICES=
# Gemini TTS model (default gemini-2.5-flash-preview-tts) and voices, e.g. {"female_a":"Kore","narrator":"Charon"}
GEMINI_TTS_MODEL=
GEMINI_TTS_VOICES=

# --- Deployment ----------------------------------------------------------------------
# REQUIRED when deployed publicly: password for the whole app (any username).
APP_PASSWORD=
# Where progress.json, ai.json, recordings, generated audio, admin library and drafts are stored
# (default ./data). On Railway: the volume mount path, e.g. /data
DATA_DIR=
# Curated content library shipped with the code (default ./content)
CONTENT_DIR=
# Server port (default 8787; Railway sets this automatically)
PORT=8787
