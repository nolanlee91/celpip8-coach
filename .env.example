# Gemini API key (https://aistudio.google.com/apikey). Required for all AI features.
GEMINI_API_KEY=
# Optional: Gemini model id (default gemini-2.5-pro). Set to a newer model when available.
GEMINI_MODEL=
# Optional locally, REQUIRED when deployed publicly: password for the whole app (any username).
APP_PASSWORD=
# Optional: where db.json and recordings are stored (default ./data). On Railway: the volume mount path, e.g. /data
DATA_DIR=
# Optional: server port (default 8787; Railway sets this automatically)
PORT=8787
