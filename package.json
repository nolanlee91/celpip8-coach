{
  "name": "celpip8-coach",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AI-powered personal CELPIP-General coach (unofficial practice tool)",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "content:validate": "tsx scripts/content-validate.ts",
    "content:generate": "tsx scripts/content-generate.ts",
    "content:review": "tsx scripts/content-review.ts",
    "content:import": "tsx scripts/content-import.ts",
    "audio:generate": "tsx scripts/audio-generate.ts",
    "test:smoke": "tsx scripts/smoke-test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tsx": "^4.23.15",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
